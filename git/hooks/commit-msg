#!/bin/sh
# Commit-msg hook to enforce Conventional Commits standard (feat, fix, docs, refactor, test, chore)

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Regular expression for Conventional Commits
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?: .+"

if ! echo "$COMMIT_MSG" | grep -iqE "$PATTERN"; then
    echo "❌ ERROR: Invalid commit message format."
    echo "Expected format: <type>(<scope>): <subject>"
    echo "Example: feat(auth): add login user validation"
    exit 1
fi

exit 0